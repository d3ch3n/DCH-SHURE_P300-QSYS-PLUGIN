        Type        = "Button",
        ButtonType  = "Toggle",         -- ou Toggle, conforme seu caso
        TextColor   = Colors.Black,
        Position    = GetIPos(i,14,{x=104,y=357},{x=140,y=540}),
        Size        = {32,32},
        FontSize = 30,
